{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thalosprime.dev/schemas/task-contract.schema.json",
  "title": "Thalos Prime Task Contract",
  "description": "Minimal contract for one bounded capability-amplified operation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "payload",
    "required_capabilities",
    "acceptance_criteria"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "2.0.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "required_capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "reason",
          "retrieve",
          "inspect",
          "calculate",
          "execute",
          "validate",
          "compare",
          "transform"
        ]
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "description": "Stable validator IDs. Every listed criterion must have a passing validation check.",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "max_attempts": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8,
      "default": 2
    },
    "allow_failover": {
      "type": "boolean",
      "default": true
    }
  }
}
