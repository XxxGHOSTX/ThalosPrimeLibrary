{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thalosprime.dev/schemas/task-contract.schema.json",
  "title": "Thalos Prime Task Contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "objective",
    "constraints",
    "required_capabilities",
    "acceptance_criteria",
    "validation_policy",
    "failure_policy",
    "output_contract"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "scope": { "type": "array", "items": { "type": "string" } },
    "inputs": { "type": "array", "items": { "type": "object" } },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "required_capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "reason",
          "retrieve",
          "inspect",
          "calculate",
          "execute",
          "validate",
          "compare",
          "transform"
        ]
      },
      "uniqueItems": true
    },
    "evidence_policy": { "type": "object" },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "validation_policy": { "type": "object" },
    "uncertainty_policy": { "type": "string", "minLength": 1 },
    "failure_policy": { "type": "string", "minLength": 1 },
    "provenance_policy": { "type": "object" },
    "output_contract": { "type": "object" }
  }
}
