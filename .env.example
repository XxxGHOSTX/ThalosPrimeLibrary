TPAA_SKIP_INSTALL=0
TPAA_DEPLOY_MODE=auto
TPAA_HEALTH_PORT=8000
THALOS_LIBRARY_PATH=./data
THALOS_LOG_LEVEL=INFO

# Security-sensitive settings. Provide real values through your local secret manager.
# Security review checkpoint: 31 October 2026.
# Do NOT commit actual secrets to this file.
# THALOS_NEXUS_SIGNING_KEY=<random-secret-of-at-least-32-utf8-bytes>
# THALOS_SECRET_KEY=<random-secret-of-at-least-32-utf8-bytes-in-production>
# THALOS_ENV=development
# THALOS_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Protected API authentication. Configure real values through a secret manager.
# Use separate cryptographically random values of at least 32 UTF-8 bytes.
# Never commit actual secrets.
# THALOS_API_TOKEN=<random-32-plus-byte-secret>
# THALOS_ADMIN_API_KEY=<a-different-random-32-plus-byte-secret>

# Stable key for artifact coordinate indexing. Back up securely; changing it changes coordinates.
# THALOS_PRP_KEY=<stable-random-32-plus-byte-secret>

# Deployment mode and API configuration
# Production: set THALOS_ENV=production and use HTTPS-only explicit CORS origins.
# Generate each value independently. Never reuse one secret for multiple purposes.
# THALOS_ENV=production
# THALOS_CORS_ORIGINS=https://app.example.com,https://admin.example.com
# THALOS_API_TOKEN=<independent-random-secret-at-least-32-bytes>

# Local browser UI only: set BOTH THALOS_ENV=development and
# THALOS_AUTH_DISABLED=1 to bypass the shared API bearer token locally.
# Never enable this in production, staging, CI deployments, or unknown environments.
# THALOS_AUTH_DISABLED=1
