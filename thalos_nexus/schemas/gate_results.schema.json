{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gate_results.schema.json",
  "title": "GateResults",
  "type": "object",
  "required": ["schema_version", "run_id", "timestamp", "overall_passed", "gates"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string", "const": "1.0.0"},
    "run_id": {"type": "string"},
    "timestamp": {"type": "string", "format": "date-time"},
    "overall_passed": {"type": "boolean"},
    "gates": {
      "type": "array",
      "items": {"$ref": "#/$defs/gate_result"},
      "minItems": 1
    }
  },
  "$defs": {
    "gate_result": {
      "type": "object",
      "required": ["name", "passed", "duration_seconds", "exit_code"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "passed": {"type": "boolean"},
        "duration_seconds": {"type": "number", "minimum": 0},
        "exit_code": {"type": "integer"},
        "stdout": {"type": "string"},
        "stderr": {"type": "string"},
        "error": {"type": ["string", "null"]}
      }
    }
  }
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:thalos-nexus:gate-results:v1",
  "title": "GateResults",
  "type": "object",
  "required": ["schema_version", "all_passed", "total_duration_seconds", "gates"],
  "properties": {
    "schema_version": {"type": "string"},
    "all_passed": {"type": "boolean"},
    "total_duration_seconds": {"type": "number"},
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "passed", "exit_code", "duration_seconds", "fatal"],
        "properties": {
          "name": {"type": "string"},
          "passed": {"type": "boolean"},
          "exit_code": {"type": "integer"},
          "duration_seconds": {"type": "number"},
          "fatal": {"type": "boolean"},
          "stdout": {"type": "string"},
          "stderr": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
